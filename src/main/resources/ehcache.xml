<?xml version="1.0" encoding="UTF-8"?>
<config xmlns='http://www.ehcache.org/v3' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
        xsi:schemaLocation='http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd'>

    <!-- Default cache configuration -->
    <cache alias="task">
        <key-type>java.lang.Long</key-type>
        <value-type>org.ust.task.entity.Task</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">100</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache>

    <cache alias="tasks">
        <key-type>java.lang.String</key-type>
        <value-type>java.util.List</value-type>
        <expiry>
            <ttl unit="minutes">15</ttl>
        </expiry>
        <resources>
            <heap unit="entries">50</heap>
            <offheap unit="MB">20</offheap>
        </resources>
    </cache>

    <cache alias="project">
        <key-type>java.lang.Long</key-type>
        <value-type>org.ust.task.entity.Project</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">100</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache>

    <cache alias="projects">
        <key-type>java.lang.String</key-type>
        <value-type>java.util.List</value-type>
        <expiry>
            <ttl unit="minutes">15</ttl>
        </expiry>
        <resources>
            <heap unit="entries">50</heap>
            <offheap unit="MB">20</offheap>
        </resources>
    </cache>

    <cache alias="comment">
        <key-type>java.lang.Long</key-type>
        <value-type>org.ust.task.entity.Comment</value-type>
        <expiry>
            <ttl unit="minutes">20</ttl>
        </expiry>
        <resources>
            <heap unit="entries">200</heap>
            <offheap unit="MB">15</offheap>
        </resources>
    </cache>

    <cache alias="comments">
        <key-type>java.lang.String</key-type>
        <value-type>java.util.List</value-type>
        <expiry>
            <ttl unit="minutes">10</ttl>
        </expiry>
        <resources>
            <heap unit="entries">100</heap>
            <offheap unit="MB">25</offheap>
        </resources>
    </cache>

    <cache alias="user">
        <key-type>java.lang.Long</key-type>
        <value-type>org.ust.task.entity.User</value-type>
        <expiry>
            <ttl unit="hours">1</ttl>
        </expiry>
        <resources>
            <heap unit="entries">50</heap>
            <offheap unit="MB">5</offheap>
        </resources>
    </cache>

    <cache alias="users">
        <key-type>java.lang.String</key-type>
        <value-type>java.util.List</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">50</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache>

</config>

